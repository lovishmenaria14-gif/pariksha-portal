{
  "name": "pariksha-portal",
  "version": "1.0.0",
  "description": "Pariksha - an NTA-pattern computer-based test portal with a calm, late-night study-room frontend.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "reset": "node src/server.js --reset"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "node": "^26.12.0"
  }
}
